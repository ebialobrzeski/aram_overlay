{
  "name": "aram-overlay",
  "version": "0.1.0",
  "description": "Always-on-top ARAM champion-select overlay that ranks available champions and team plans for the best composition.",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "demo": "node scripts/build.mjs && electron . --demo",
    "debug": "node scripts/build.mjs && electron . --aram-debug",
    "test": "node scripts/build.mjs --tests && node --test dist/test/"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
